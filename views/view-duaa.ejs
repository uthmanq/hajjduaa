<%- include('partials/head', { title: 'Duaa ' + duaa.request_number }) %>

<div class="max-w-2xl mx-auto">
  <a href="/search" class="text-sm text-sand-700 inline-flex items-center gap-1 mb-4 hover:text-emerald-800">
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    Look up another
  </a>

  <div class="bg-white border border-sand-200 rounded-2xl p-6 sm:p-8 shadow-soft">
    <div class="flex items-center justify-between mb-4">
      <code class="text-sm font-mono text-sand-600 tracking-wider"><%= duaa.request_number %></code>
      <% if (duaa.completion_count > 0) { %>
        <span class="inline-flex items-center gap-1.5 bg-emerald-700/10 text-emerald-800 text-sm font-medium px-3 py-1 rounded-full">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Carried <%= duaa.completion_count %><%= duaa.completion_count === 1 ? ' time' : ' times' %>
        </span>
      <% } else { %>
        <span class="inline-flex items-center gap-1.5 bg-sand-200/70 text-sand-800 text-sm font-medium px-3 py-1 rounded-full">
          Awaiting a pilgrim
        </span>
      <% } %>
    </div>

    <p class="text-lg leading-relaxed text-sand-900 whitespace-pre-wrap"><%= duaa.duaa_text %></p>

    <% if (duaa.requester_country) { %>
      <p class="mt-6 text-sm text-sand-600">From <%= nameFor(duaa.requester_country) %></p>
    <% } %>
  </div>

  <section class="mt-8">
    <h2 class="text-lg font-semibold mb-4">
      <% if (completions.length === 0) { %>
        No one has carried this duaa yet.
      <% } else { %>
        Carried by pilgrims from…
      <% } %>
    </h2>

    <% if (completions.length === 0) { %>
      <p class="text-sand-700 bg-sand-100 border border-sand-200 rounded-xl p-4">
        Be patient. Pilgrims are picking up duaas as they arrive at the Haram, in shaa Allah.
      </p>
    <% } else { %>
      <ul class="space-y-2">
        <% completions.forEach(c => { %>
          <li class="bg-white border border-sand-200 rounded-xl px-4 py-3 flex items-center justify-between">
            <span class="font-medium text-sand-900">
              <%= c.pilgrim_country ? nameFor(c.pilgrim_country) || 'A pilgrim' : 'A pilgrim' %>
            </span>
            <time class="text-sm text-sand-600" datetime="<%= c.created_at %>"><%= c.created_at.split(' ')[0] %></time>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('partials/foot') %>
