<%- include('partials/head', { title: 'Request a duaa' }) %>

<div class="max-w-xl mx-auto">
  <a href="/" class="text-sm text-sand-700 inline-flex items-center gap-1 mb-4 hover:text-emerald-800">
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    Back
  </a>
  <h1 class="text-3xl font-semibold mb-2">Share your duaa</h1>
  <p class="text-sand-700 mb-6">A pilgrim on Hajj will carry it to the Haram, in shaa Allah.</p>

  <% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-lg px-4 py-3 mb-4 text-sm">
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="/request" class="bg-white border border-sand-200 rounded-2xl p-6 space-y-5 shadow-soft">
    <div>
      <label for="duaa_text" class="block text-sm font-medium mb-1">Your duaa</label>
      <textarea
        id="duaa_text"
        name="duaa_text"
        required
        minlength="5"
        maxlength="1000"
        rows="6"
        placeholder="O Allah, ease the affliction of my mother…"
        class="w-full rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      ><%= values.duaa_text || '' %></textarea>
      <p class="text-xs text-sand-600 mt-1">Up to 1000 characters. Please don't include personal details you wouldn't want shared.</p>
    </div>

    <div>
      <label for="country" class="block text-sm font-medium mb-1">Country <span class="text-sand-500 font-normal">(optional)</span></label>
      <select
        id="country"
        name="country"
        class="w-full rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      >
        <option value="">— Prefer not to say —</option>
        <% countries.forEach(c => { %>
          <option value="<%= c.code %>" <%= values.country === c.code ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="email" class="block text-sm font-medium mb-1">Email <span class="text-sand-500 font-normal">(optional)</span></label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        value="<%= values.email || '' %>"
        placeholder="you@example.com"
        class="w-full rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      />
      <p class="text-xs text-sand-600 mt-1">If provided, we may notify you when your duaa has been carried. We'll never share your email.</p>
    </div>

    <%- include('partials/captcha') %>

    <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-sand-50 font-medium rounded-lg px-4 py-3 transition shadow-soft">
      Send my duaa
    </button>
  </form>
</div>

<%- include('partials/foot') %>
