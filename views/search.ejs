<%- include('partials/head', { title: 'Look up a duaa' }) %>

<div class="max-w-xl mx-auto">
  <a href="/" class="text-sm text-sand-700 inline-flex items-center gap-1 mb-4 hover:text-emerald-800">
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    Back
  </a>
  <h1 class="text-3xl font-semibold mb-2">Look up your duaa</h1>
  <p class="text-sand-700 mb-6">Enter the number you received when you submitted your duaa.</p>

  <% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-lg px-4 py-3 mb-4 text-sm">
      <%= error %>
    </div>
  <% } %>

  <form method="GET" action="/search" class="bg-white border border-sand-200 rounded-2xl p-6 shadow-soft">
    <label for="number" class="block text-sm font-medium mb-1">Duaa number</label>
    <div class="flex flex-col sm:flex-row gap-3">
      <input
        id="number"
        name="number"
        required
        autofocus
        autocomplete="off"
        spellcheck="false"
        placeholder="HD-XXXXXX"
        pattern="[A-Za-z0-9\-]{3,20}"
        class="flex-1 rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 font-mono uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      />
      <button class="bg-emerald-700 hover:bg-emerald-800 text-sand-50 font-medium rounded-lg px-5 py-2.5 transition shadow-soft">
        Look up
      </button>
    </div>
  </form>
</div>

<%- include('partials/foot') %>
