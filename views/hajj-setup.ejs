<%- include('partials/head', { title: 'Set up your session' }) %>

<div class="max-w-xl mx-auto">
  <a href="/hajj" class="text-sm text-sand-700 inline-flex items-center gap-1 mb-4 hover:text-emerald-800">
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    Back
  </a>
  <h1 class="text-3xl font-semibold mb-2">A little about you</h1>
  <p class="text-sand-700 mb-6">So requesters can see where their duaa was carried from.</p>

  <% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-lg px-4 py-3 mb-4 text-sm">
      <%= error %>
    </div>
  <% } %>

  <form method="POST" action="/hajj/setup" class="bg-white border border-sand-200 rounded-2xl p-6 space-y-5 shadow-soft">
    <div>
      <label for="country" class="block text-sm font-medium mb-1">I am from</label>
      <select
        id="country"
        name="country"
        required
        class="w-full rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      >
        <option value="">— Choose your country —</option>
        <% countries.forEach(c => { %>
          <option value="<%= c.code %>" <%= values.country === c.code ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="email" class="block text-sm font-medium mb-1">Email <span class="text-sand-500 font-normal">(optional)</span></label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        value="<%= values.email || '' %>"
        placeholder="you@example.com"
        class="w-full rounded-lg border border-sand-300 bg-sand-50 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-700/40 focus:border-emerald-700"
      />
      <p class="text-xs text-sand-600 mt-1">By providing your email, you agree to receive occasional updates from Hajj Duaa about the platform. We will never share or sell your email.</p>
    </div>

    <label class="flex items-start gap-3 cursor-pointer select-none">
      <input type="checkbox" name="honor" required class="mt-1 w-4 h-4 accent-emerald-700" />
      <span class="text-sm text-sand-800">I confirm that I am performing Hajj and will sincerely make these duaas.</span>
    </label>

    <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-sand-50 font-medium rounded-lg px-5 py-3 transition shadow-soft text-lg">
      Let's go
    </button>
  </form>
</div>

<%- include('partials/foot') %>
