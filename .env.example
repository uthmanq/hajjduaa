# Server
PORT=3000
NODE_ENV=production

# Cookie / session signing key (any long random string)
COOKIE_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Free CAPTCHA. Leave blank to disable verification (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Per-pilgrim-session cap on duaas they can fulfill
MAX_DUAAS_PER_SESSION=20

# Where SQLite lives. Default ./data/hajjduaa.db
# DB_PATH=/var/lib/hajjduaa/hajjduaa.db
